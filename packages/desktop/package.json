{
  "private": true,
  "name": "xenonstream-desktop",
  "description": "XenonStream is a cross-platform streaming client for Xbox Remote Play and Xbox Cloud Gaming (xCloud)",
  "version": "1.0.0",
  "author": "oscarlosu-lab",
  "license": "MIT",
  "main": "app/background.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oscarlosu-lab/xenonstream.git"
  },
  "scripts": {
    "dev": "DEBUG=xenonstream:* nextron",
    "build": "nextron build",
    "lint": "eslint . --ext .ts && eslint renderer/ --ext .tsx",
    "lint:strict": "eslint . --ext .ts --max-warnings=0 && eslint renderer/ --ext .tsx --max-warnings=0",
    "lint:fix": "eslint . --ext .ts --fix && eslint renderer/ --ext .tsx --fix",
    "typecheck": "node ../../node_modules/typescript/bin/tsc -p tsconfig.test.json --noEmit",
    "test": "node ../../node_modules/jest/bin/jest.js",
    "test:open-handles": "node --unhandled-rejections=strict ../../node_modules/jest/bin/jest.js --no-coverage --runInBand --detectOpenHandles --errorOnDeprecated",
    "test:leaks": "node --expose-gc --unhandled-rejections=strict ../../node_modules/jest/bin/jest.js --no-coverage --runInBand --detectLeaks --errorOnDeprecated",
    "test:sanitizers": "node --expose-gc --unhandled-rejections=strict ../../node_modules/jest/bin/jest.js --no-coverage --runInBand --detectOpenHandles --detectLeaks --errorOnDeprecated --randomize",
    "test:xcloud": "node --test tests/xcloud.test.cjs",
    "test:disabled": "CI=true nextron build --no-pack && CI=true xvfb-maybe -- playwright test -c playwright.config.ts",
    "test-serve": "npx http-server app/ -p 3000",
    "postinstall": "electron-builder install-app-deps",
    "publish": "electron-builder -p onTag",
    "flatpak-build": "nextron build --no-pack && electron-builder --dir"
  },
  "dependencies": {
    "@types/i18next": "^13.0.0",
    "@types/react-i18next": "^8.1.0",
    "axios": "^1.21.0",
    "compare-versions": "^6.1.1",
    "debug": "^4.3.4",
    "electron-serve": "^3.0.0",
    "electron-store": "^12.0.0",
    "express": "^5.2.1",
    "express-http-proxy": "^2.1.1",
    "express-ws": "^5.0.2",
    "github-url-to-object": "^4.0.6",
    "i18next": "^26.4.2",
    "ip-address": "^10.7.0",
    "react-i18next": "^18.0.1",
    "react-qr-code": "^2.2.0",
    "react-query": "^3.39.3",
    "typescript-eslint": "^8.67.0",
    "uplot": "^1.6.30",
    "xal-node": "^1.1.6-beta2",
    "xbox-webapi": "^2.0.0-beta4",
    "xbox-xcloud-player": "0.2.11",
    "xvfb-maybe": "^0.2.1"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@next/eslint-plugin-next": "^16.2.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "babel-loader": "^10.0.0",
    "electron": "45.3.4",
    "electron-builder": "^26.8.1",
    "eslint": "^10.3.0",
    "jest": "^30.1.3",
    "next": "^16.1.0",
    "nextron": "^10.0.0",
    "node-loader": "^2.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ts-jest": "^29.1.2",
    "typescript": "^5.9.3"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
